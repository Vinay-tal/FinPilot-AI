# FinPilot AI Backend Environment Configuration

# Core Application Settings
PROJECT_NAME="FinPilot AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL recommended; SQLite supported for local development)
DATABASE_URL="sqlite:///./finpilot.db"
# DATABASE_URL="postgresql+psycopg://finpilot:finpilot_password@localhost:5432/finpilot_db"

# JWT Authentication
# SECURITY WARNING: Generate a secure 256-bit random key in production: openssl rand -hex 32
JWT_SECRET="dev_secret_key_change_in_production_finpilot_super_secure_jwt_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Copilot Configuration
# Options: "mock" (offline deterministic provider) or "groq"
AI_PROVIDER="mock"
LLM_PROVIDER="mock"
GROQ_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.2

# Server Networking
HOST="0.0.0.0"
PORT=8000
