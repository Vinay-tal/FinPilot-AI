# FinPilot AI Environment Configuration

# Application
PROJECT_NAME="FinPilot AI: Intelligent Personal Financial Advisor for Indian Users"
ENVIRONMENT="development" # "development", "testing", "production"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL is the primary production/dev database)
# When running with Docker Compose: docker compose up -d
DATABASE_URL="postgresql+psycopg://finpilot:finpilot_password@localhost:5432/finpilot_db"

# Fallback Database (If local PostgreSQL is unavailable, set this to sqlite:///./finpilot.db)
# DATABASE_URL="sqlite:///./finpilot.db"

# JWT Authentication
# In production, generate with: openssl rand -hex 32
JWT_SECRET="dev_secret_key_change_in_production_finpilot_super_secure_jwt_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours

# AI / Copilot Provider Configuration
# Set LLM_PROVIDER="groq" for production or "mock" for offline deterministic development/testing
AI_PROVIDER="mock"
LLM_PROVIDER="mock"
GROQ_API_KEY="" # Required when LLM_PROVIDER="groq"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.2

# Demo Persona Configuration
DEMO_USER_EMAIL="demo@finpilot.in"
DEMO_USER_PASSWORD="Demo@FinPilot2026!"
DEMO_USER_NAME="Rahul Sharma"
DEMO_USER_CURRENCY="INR"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
